<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- SMB bağlantısı için ağ izinleri -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 13+ fotoğraf erişimi -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Izgarada videolar da göründüğü için (hareketli küçük resimler) -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Android 14+ kısmi (seçili fotoğraf) erişimi -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- Android 12 ve altı için eski izin -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
        ARKA PLAN KORUMASI (kullanıcı isteği): pil optimizasyonu muafiyeti
        için Ayarlar ekranı açılır; ön plan hizmeti SMB oturumunu ve zaman
        tüneli tazeliğini canlı tutar. dataSync tipi Android 14+ zorunlu.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".SmpMediaApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmpMedia"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:largeHeap="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SmpMedia"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode|layoutDirection|fontScale|locale">
            <!--
                KATLANABİLİR CİHAZ (Pixel 10 Pro Fold): açma/kapama sırasında
                ekran boyutu, en-küçük-kenar ve yoğunluk değişir. Bu değişimleri
                sistem yeniden oluşturma (recreation) yapmadan Activity'e
                bildiriyoruz; Compose yeni ölçülere kendini yeniden kurar.
                Böylece kat değiştirirken ızgara kaydırma konumu, açık diyalo-
                ğu ve en önemlisi İZLENEN FOTOĞRAF/VIDEO (ExoPlayer dahil)
                sıfırlanmaz. Google Photos'un katlar arası kesintisiz davranışı
                de budur.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Arka plan koruması hizmeti: Ayarlar ekranındaki anahtarla açılır.
            exported=false — yalnızca kendi uygulamamız başlatır.
        -->
        <service
            android:name=".data.sync.MediaSyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
            WorkManager'ı Hilt'in WorkerFactory'si ile başlatacağımız için
            varsayılan başlatıcıyı kaldırıyoruz.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!--
            SMB fotoğraflarını Paylaş/Düzenle gibi sistem uygulamalarına
            açmak için önbellek kopyaları bu provider üzerinden verilir.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
